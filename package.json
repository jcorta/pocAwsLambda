{
  "name": "poc-aws-lambda",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "doctor": "node scripts/doctor.mjs",
    "local:up": "node scripts/local/up.mjs",
    "local:seed": "node scripts/local/seed.mjs",
    "local:logs": "node scripts/local/logs.mjs",
    "local:down": "node scripts/local/down.mjs",
    "local:reset": "node scripts/local/down.mjs --reset",
    "deploy:local": "node scripts/local/deploy.mjs",
    "deploy:web:local": "node scripts/local/deploy-web.mjs",
    "aws:deploy": "node scripts/aws/deploy.mjs",
    "aws:admin": "node scripts/aws/admin.mjs",
    "aws:destroy": "node scripts/aws/destroy.mjs",
    "test:e2e:ui": "pnpm --filter @reservas/web test:e2e:ui",
    "secrets:staged": "node scripts/gitleaks.mjs --staged",
    "secrets:history": "node scripts/gitleaks.mjs --all",
    "build": "pnpm -r --if-present build",
    "dev": "node scripts/local/dev.mjs",
    "local:site": "node scripts/local/site.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node --test \"scripts/**/*.test.mjs\"",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "lint:infra": "node scripts/infra.mjs lint",
    "test:infra": "node scripts/infra.mjs test"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1145.0",
    "@aws-sdk/client-lambda": "^3.1145.0",
    "@aws-sdk/client-resource-groups-tagging-api": "^3.1146.0",
    "@aws-sdk/client-s3": "^3.1145.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "~24.19.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "lefthook": "^2.1.16",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
