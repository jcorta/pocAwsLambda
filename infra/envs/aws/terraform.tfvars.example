# Copiar a terraform.tfvars (está en .gitignore). `pnpm aws:deploy` lo pide si falta (SPEC §11.1).
# Las variables que no aparecen toman los valores de SPEC §7.3 (ver main.tf).

region = "us-east-1"

# Remitente de los emails de reservas: un email tuyo. AWS le manda un link para verificarlo.
# En el sandbox de SES solo se envía a direcciones verificadas, así que verificá también los
# emails con los que te registres en el sitio (o usá el mismo).
# Ojo: con un remitente @gmail.com, SES acepta y entrega el mensaje, pero Gmail lo descarta o lo
# esconde (SPEC §11.3). Para ver los emails, usá un remitente de otro dominio.
ses_from = "tu-email@example.com"

# Si RDS falla con InsufficientDBInstanceCapacity, primero comprobar que la cuenta pueda pedir la clase:
#   aws rds describe-orderable-db-instance-options --engine postgres --db-instance-class db.t3.micro
# Si la clase está disponible, probar otras AZ (las subnets se recrean):
# availability_zones = ["us-east-1c", "us-east-1d"]

# Si RDS falla con FreeTierRestrictionError (cuenta en la capa gratuita), bajar la retención de backups:
# db_backup_retention_days = 1
