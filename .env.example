# Copiar a .env.local y ajustar si hace falta. .env.local NO se versiona.
# Valores aptos SOLO para el entorno local (Floci) y la CI. Nunca usarlos en AWS real.

# Zona horaria del sistema (SPEC §2.2)
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Usuarios que crea el seed en Cognito (SPEC §10.2).
# Las contraseñas deben cumplir la política: 8+ caracteres, con mayúsculas, minúsculas y números.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin-local-1
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=User-local-1
